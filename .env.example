# CLI runners load .env; existing environment variables have priority.
# Fill one shared PUBLIC W&B project before reporting results.
WANDB_ENTITY=
WANDB_PROJECT=wrs-reproduction-group8
# Choose --wandb-mode online explicitly for runs intended for public reporting.
WANDB_MODE=disabled
# Authenticate locally with wandb login; never commit an API key.
WRS_DATA_DIR=data/raw
WRS_RESULTS_DIR=results/raw
